# Local development defaults. Copy this file to .env at the repository root.
# These values are local placeholders, not production secrets. Do not put real
# passwords, API keys, or session tokens in this file or in git.

# development | test | production
# production refuses to start unless the session cookie is Secure.
APP_ENV=development

# SQLAlchemy URL. "healthify" is the local database password only.
DATABASE_URL=postgresql+psycopg://healthify:healthify@localhost:5432/healthify

# Comma-separated exact browser origins. Wildcards are rejected.
# The local frontend origin is http://localhost:5173 (not http://127.0.0.1:5173).
CORS_ORIGINS=http://localhost:5173

# Opaque HttpOnly session cookie. SameSite=Lax, Path=/, no Domain attribute.
SESSION_COOKIE_NAME=healthify_session

# Absolute session lifetime in seconds (7 days). Activity does not extend it.
SESSION_TTL_SECONDS=604800

# Secure cookie flag. Leave unset to default false for development/test and
# true for production. Local HTTP (http://localhost) must stay false or the
# browser will drop the cookie. Uncomment only for local HTTP:
# SESSION_COOKIE_SECURE=false

# Failed logins per immediate client IP per rolling window.
# Attempts 1-5 return 401. Attempt 6 inside the window returns 429.
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Ignore X-Forwarded-For unless a trusted proxy appends the real peer address.
TRUST_X_FORWARDED_FOR=false
