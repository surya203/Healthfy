{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "^/api/(?<proxyPath>.+)$",
      "continue": true,
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/$proxyPath"
        }
      ]
    }
  ]
}
